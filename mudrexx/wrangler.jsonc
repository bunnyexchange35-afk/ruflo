{
  // MUDREXX backend — Cloudflare Worker + D1 (§9).
  //
  // IMPORTANT: the local dev/miniflare database is NOT production.
  // `database_id` below must be the id of the real production D1 database
  // (`npx wrangler d1 list`). It is an identifier, not a credential.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudrexx-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mudrexx_db",
      // TODO(provision): replace with the real production D1 id before deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "LLM_PROVIDER_ORDER": "openai,anthropic,openrouter,google,ollama",
    "ALLOWED_ORIGINS": ""
  },

  "observability": {
    "enabled": true
  },

  // §6 Environment separation.
  //
  // The TOP-LEVEL block above is the PRODUCTION environment (wrangler's default
  // environment). `env.staging` and `env.development` are fully separate
  // deployments: separate Worker name, separate D1 database, separate secrets.
  //
  //   production   npx wrangler deploy                     -> mudrexx-backend
  //   staging      npx wrangler deploy --env staging       -> mudrexx-backend-staging
  //   development  npx wrangler dev                        -> local miniflare + --local D1
  //
  // Staging configuration can never reach production: the deploy pipeline runs
  // `scripts/ci/check-config.mjs --target production`, which asserts that
  // vars.ENVIRONMENT === "production" and that the bound D1 database is not a
  // staging/dev database.
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "LLM_PROVIDER_ORDER": "openai,anthropic,openrouter,google,ollama",
        "ALLOWED_ORIGINS": ""
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mudrexx_db_staging",
          // TODO(provision): replace with the real staging D1 id before deploying to staging.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },

    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "LLM_PROVIDER_ORDER": "openai,anthropic,openrouter,google,ollama",
        "ALLOWED_ORIGINS": "http://localhost:5173"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mudrexx_db_dev",
          // Local development uses miniflare's simulated D1 (`--local`), where
          // this id is not used. Provision a real dev D1 only if you deploy it.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
