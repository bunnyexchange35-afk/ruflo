{
  "name": "@mudrexx/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MUDREXX central backend — Hono + Cloudflare Workers + D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 0.0.0.0",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply mudrexx_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mudrexx_db --remote",
    "db:list": "wrangler d1 list",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "ci:config": "node scripts/ci/check-config.mjs --target production",
    "ci:config:staging": "node scripts/ci/check-config.mjs --target staging",
    "ci:migrations": "node scripts/ci/check-migrations.mjs --target production --offline",
    "ci:health": "node scripts/ci/health-check.mjs",
    "ci:smoke": "node scripts/ci/smoke-readonly.mjs",
    "ci:report": "node scripts/ci/report.mjs --dir artifacts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.91.0"
  }
}
