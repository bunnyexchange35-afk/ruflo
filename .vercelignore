data
bin
*.gif
*.png
*.jpg
package-lock.json
pnpm-lock.yaml

# mudrexx: only the portal and the proxy are needed to build the site.
mudrexx/src
mudrexx/tests
mudrexx/migrations
mudrexx/scripts
mudrexx/ci
mudrexx/package-lock.json
